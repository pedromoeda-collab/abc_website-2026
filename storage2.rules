rules_version = '2';
// Regras Storage — Clube Desportivo ABC
// Publicar em: Firebase Console → Storage → Regras → colar → Publicar
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'pedromoeda@gmail.com';
    }

    match /{folder}/{file=**} {
      allow read: if folder in ['media', 'players', 'coaches', 'organs', 'partners'];
      // Envio: só imagens até 5MB (o site já comprime antes de enviar). Apagar: só admin.
      allow create, update: if isAdmin()
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
